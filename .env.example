# Turso (libSQL) database — from `turso db create` / `turso db tokens create`
TURSO_DATABASE_URL="libsql://your-db-name.turso.io"
TURSO_AUTH_TOKEN="your-turso-auth-token"

# Stripe (test mode keys from https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY="sk_test_..."
# Signing secret for the event destination scoped to "Your account" (invoice.*)
STRIPE_WEBHOOK_SECRET="whsec_..."
# Signing secret for the event destination scoped to "Connected accounts"
# (account.updated). Same endpoint URL, separate destination, separate secret.
STRIPE_WEBHOOK_SECRET_CONNECT="whsec_..."

# Clerk (from https://dashboard.clerk.com — API Keys page)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# Vercel Blob (created from Vercel project Storage -> Blob)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Mailtrap Email API (Settings -> API Tokens, token must have sending permission)
MAILTRAP_API_TOKEN="mailtrap_api_token"
# Optional override; defaults to Mailtrap transactional sending.
MAILTRAP_SEND_ENDPOINT="https://send.api.mailtrap.io/api/send"
MAIL_FROM="invoice@idesignlc.com"
MAIL_FROM_NAME="Invoice by iDesignLC"

# Base URL used to build Stripe return/refresh links
NEXT_PUBLIC_APP_URL="http://localhost:3000"

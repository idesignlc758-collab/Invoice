# Postgres connection string (Neon / Vercel Postgres / Supabase / local)
DATABASE_URL="postgresql://user:password@localhost:5432/checkout?schema=public"

# Stripe (test mode keys from https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Auth.js
NEXTAUTH_SECRET="generate with: npx auth secret"
NEXTAUTH_URL="http://localhost:3000"

# Mailtrap (Sandbox for dev: sandbox.smtp.mailtrap.io — Sending API for prod: live.smtp.mailtrap.io)
MAILTRAP_HOST="sandbox.smtp.mailtrap.io"
MAILTRAP_PORT="587"
MAILTRAP_USER=""
MAILTRAP_PASS=""
MAIL_FROM="invoices@yourdomain.com"

# Base URL used to build Stripe return/refresh links
NEXT_PUBLIC_APP_URL="http://localhost:3000"

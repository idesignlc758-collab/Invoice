// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id               String    @id @default(cuid())
  clerkId          String    @unique
  email            String    @unique
  stripeAccountId  String?   @unique
  onboardingStatus String    @default("not_started") // not_started | pending | ready
  createdAt        DateTime  @default(now())
  invoices         Invoice[]
}

model Invoice {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id])
  stripeInvoiceId  String    @unique
  stripeCustomerId String
  clientEmail      String
  clientName       String?
  description      String // summary line for list views; full detail lives in lineItems
  subtotal         Int       @default(0) // pre-tax, in cents
  taxPercent       Float     @default(0)
  taxAmount        Int       @default(0) // in cents
  amount           Int // total including tax, in cents
  feeAmount        Int // platform fee, in cents
  currency         String    @default("usd")
  status           String    @default("draft") // draft | open | paid | void | uncollectible | payment_failed
  hostedInvoiceUrl String?
  dueDate          DateTime?
  paidAt           DateTime?
  createdAt        DateTime  @default(now())

  lineItems InvoiceLineItem[]

  @@index([userId])
}

model InvoiceLineItem {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Int     @default(1)
  unitAmount  Int // per unit, in cents
  amount      Int // quantity * unitAmount, in cents
  position    Int     @default(0)

  @@index([invoiceId])
}

model WebhookEvent {
  id            String   @id @default(cuid())
  stripeEventId String   @unique
  type          String
  processedAt   DateTime @default(now())
}

// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id               String    @id @default(cuid())
  clerkId          String    @unique
  email            String    @unique
  stripeAccountId  String?   @unique
  onboardingStatus String    @default("not_started") // not_started | pending | ready
  createdAt        DateTime  @default(now())
  invoices         Invoice[]
  clients          Client[]
  products         Product[]
  businessProfile  BusinessProfile?
}

model Client {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id])
  email            String
  name             String?
  stripeCustomerId String?
  lastInvoicedAt   DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  invoices         Invoice[]

  @@unique([userId, email])
  @@index([userId])
}

model Product {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  stripeProductId String?
  stripePriceId   String?
  name        String
  description String?
  unitAmount  Int
  currency    String   @default("usd")
  type        String   @default("service") // service | product | hourly | custom
  taxable     Boolean  @default(true)
  active      Boolean  @default(true)
  timesUsed   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lineItems InvoiceLineItem[]

  @@unique([userId, name])
  @@index([userId])
}

model BusinessProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id])
  businessName      String?
  logoUrl           String?
  brandColor        String   @default("#c81010")
  supportEmail      String?
  website           String?
  invoiceFooter     String?
  defaultTermsDays  Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Invoice {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id])
  clientId         String?
  client           Client?   @relation(fields: [clientId], references: [id])
  publicToken      String    @unique @default(cuid())
  stripeInvoiceId  String    @unique
  stripeCustomerId String
  invoicePdfUrl    String?
  stripeNumber     String?
  clientEmail      String
  clientName       String?
  description      String // summary line for list views; full detail lives in lineItems
  subtotal         Int       @default(0) // pre-tax, in cents
  taxPercent       Float     @default(0)
  taxAmount        Int       @default(0) // in cents
  amount           Int // total including tax, in cents
  feeAmount        Int // platform fee, in cents
  currency         String    @default("usd")
  status           String    @default("draft") // draft | open | paid | void | uncollectible | payment_failed
  hostedInvoiceUrl String?
  deliveryMode     String    @default("stripe_email") // stripe_email | branded_email | manual_link
  brandBusinessName String?
  brandLogoUrl     String?
  brandColor       String?
  brandSupportEmail String?
  brandFooter      String?
  dueDate          DateTime?
  paidAt           DateTime?
  createdAt        DateTime  @default(now())

  lineItems InvoiceLineItem[]

  @@index([userId])
}

model InvoiceLineItem {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id])
  description String
  productName String?
  productType String?
  quantity    Int     @default(1)
  unitAmount  Int // per unit, in cents
  amount      Int // quantity * unitAmount, in cents
  position    Int     @default(0)

  @@index([invoiceId])
  @@index([productId])
}

model WebhookEvent {
  id            String   @id @default(cuid())
  stripeEventId String   @unique
  type          String
  processedAt   DateTime @default(now())
}
